      "acf": {
        "frame_duration_ms": 25.0,
        "hop_duration_ms": 10.0,
        "f0_min": 70.0,
        "f0_max": 400.0,
        "ste_silence_ratio": 0.008,
        "use_median_filter": true,
        "median_size": 3,
        "reference_threshold": 0.4408,
        "pre_processors": [],
        "post_processors": []
      },
      "amdf": {
        "frame_duration_ms": 25.0,
        "hop_duration_ms": 10.0,
        "f0_min": 70.0,
        "f0_max": 400.0,
        "ste_silence_ratio": 0.008,
        "use_median_filter": true,
        "median_size": 3,
        "reference_threshold": 0.438,
        "pre_processors": [],
        "post_processors": []
      },
      "cepstrum": {
        "frame_duration_ms": 25.0,
        "hop_duration_ms": 10.0,
        "f0_min": 70.0,
        "f0_max": 400.0,
        "ste_silence_ratio": 0.008,
        "use_median_filter": true,
        "median_size": 3,
        "reference_threshold": 0.06,
        "pre_processors": [],
        "post_processors": []
      }
    }
  },
  "pipelines": {
    "acf": {
      "frame_duration_ms": 30.0,
      "hop_duration_ms": 10.0,
      "f0_min": 70.0,
      "f0_max": 400.0,
      "ste_silence_ratio": 0.008,
      "use_median_filter": true,
      "median_size": 3,
      "reference_threshold": 0.45,
      "pre_processors": [
        {
          "name": "BandpassPreFilter",
          "parameters": {
            "low_cutoff": 70.0,
            "high_cutoff": 900.0,
            "order": 2
          }
        }
      ],
      "post_processors": [
        {
          "name": "EnergyEdgeExtension",
          "parameters": {
            "threshold_discount": 0.2,
            "min_voiced_len": 3,
            "max_pitch_diff": 40.0,
            "ste_multiplier": 1.5
          }
        },
        {
          "name": "ViterbiTracking",
          "parameters": {
            "w_freq": 3.0,
            "w_octave": 4.0,
            "max_candidates": 5,
            "f0_min": 70.0,
            "f0_max": 400.0
          }
        }
      ]
    },
    "amdf": {
      "frame_duration_ms": 30.0,
      "hop_duration_ms": 10.0,
      "f0_min": 70.0,
      "f0_max": 400.0,
      "ste_silence_ratio": 0.008,
      "use_median_filter": true,
      "median_size": 3,
      "reference_threshold": 0.5,
      "pre_processors": [],
      "post_processors": [
        {
          "name": "EnergyEdgeExtension",
          "parameters": {
            "threshold_discount": 0.2,
            "min_voiced_len": 3,
            "max_pitch_diff": 40.0,
            "ste_multiplier": 1.5
          }
        },
        {
          "name": "ViterbiTracking",
          "parameters": {
            "w_freq": 3.0,
            "w_octave": 4.0,
            "max_candidates": 5,
            "f0_min": 70.0,
            "f0_max": 400.0
          }
        }
      ]
    },
    "cepstrum": {
      "frame_duration_ms": 30.0,
      "hop_duration_ms": 10.0,
      "f0_min": 70.0,
      "f0_max": 400.0,
      "ste_silence_ratio": 0.008,
      "use_median_filter": true,
      "median_size": 3,
      "reference_threshold": 0.1,
      "pre_processors": [
        {
          "name": "BandpassPreFilter",
          "parameters": {
            "low_cutoff": 70.0,
            "high_cutoff": 900.0,
            "order": 2
          }
        },
        {
          "name": "CenterClipping",
          "parameters": {
            "clipping_ratio": 0.4,
            "mode": "standard"
          }
        }
      ],
      "post_processors": [
        {
          "name": "EnergyEdgeExtension",
          "parameters": {
            "threshold_discount": 0.2,
            "min_voiced_len": 3,
            "max_pitch_diff": 40.0,
            "ste_multiplier": 1.5
          }
        },
        {
          "name": "ViterbiTracking",
          "parameters": {
            "w_freq": 3.0,
            "w_octave": 4.0,
            "max_candidates": 5,
            "f0_min": 70.0,
            "f0_max": 400.0
          }
        }
      ]
    }
  },
  "fit": {
    "mode": "frozen",
    "population": "train_active",
    "strategies": [
      "otsu",
      "kmeans",
      "kmeans2d",
      "dynamic"
    ],
    "input_adaptive_controls": [
      "kmeans2d_input_active"
    ],
    "parameters": {
      "histogram": {
        "n_bins": 100
      },
      "kmeans": {
        "clusters": 2,
        "max_iter": 100,
        "tol": 1e-05
      },
      "kmeans2d": {
        "max_iter": 100,
        "tol": 1e-05
      },
      "dynamic": {
        "base": "otsu",
        "window_frames": 50,
        "alpha": 0.3,
        "context": "within active segments; offline centered window"
      }
    }
  }
}
