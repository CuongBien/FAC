  "description": "Executable fixed v1 protocol. Every numerical setting is checked; unsupported overrides are rejected.",
  "fit": {
    "input_adaptive_controls": [
      "kmeans2d_input_active",
      "hmm_input_active"
    ],
    "mode": "frozen",
    "parameters": {
      "dynamic": {
        "alpha": 0.3,
        "context": "within active segments; STE normalized within each segment; offline window",
        "window_frames": 50
      },
      "energy_guard": "fixed_champion_threshold_for_every_strategy",
      "gmm": {
        "max_iter": 150,
        "prior": 0.5,
        "tol": 1e-05
      },
      "histogram": {
        "n_bins": 100,
        "valley_smooth_sigma": 2.0
      },
      "hmm": {
        "A": [
          [
            0.85,
            0.15
          ],
          [
            0.15,
            0.85
          ]
        ],
        "learn_transitions": false,
        "max_iter": 40,
        "prior": 0.5,
        "tol": 0.0001
      },
      "kmeans": {
        "clusters": 2,
        "max_iter": 100,
        "tol": 1e-05
      },
      "kmeans2d": {
        "max_iter": 100,
        "tol": 1e-05
      },
      "zcr_source": "DC-centered pitch_frames after bandpass/center clipping"
    },
    "population": "train_active",
    "strategies": [
      "median",
      "otsu",
      "valley",
      "kmeans",
      "gmm",
