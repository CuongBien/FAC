# Only new experiment infrastructure adopts a canonical checkout policy.
src/experiments/** text eol=lf
tests/test_experiments.py text eol=lf
configs/** text eol=lf
# New stores write UTF-8/LF themselves; Git must preserve artifact bytes.
outputs/runs/** -text
outputs/registry.json -text
outputs/refactor_phase1/** -text
# Shared pipeline and its new proof use the same explicit checkout policies.
src/pipeline/** text eol=lf
tests/test_pipeline_contracts.py text eol=lf
scripts/22_verify_pipeline_refactor.py text eol=lf
outputs/refactor_phase2/** -text
# Runner proof bundles retain their exact archived bytes.
tests/test_runner.py text eol=lf
scripts/23_verify_runner_refactor.py text eol=lf
outputs/refactor_phase3/** -text
src/metrics/** text eol=lf
tests/test_metrics.py text eol=lf
scripts/24_verify_metric_refactor.py text eol=lf
outputs/refactor_phase4/** -text
